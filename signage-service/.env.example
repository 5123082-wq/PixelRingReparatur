# PixelRing signage-service environment contract
#
# Commit this file. Do not put real secrets here.
# Server rule: configure these variables in the hosting provider, not by
# uploading .env.local.

# Required at runtime. Prisma uses POSTGRES_PRISMA_URL first, DATABASE_URL second.
POSTGRES_PRISMA_URL=
DATABASE_URL=

# Required for production absolute links in emails and metadata.
NEXT_PUBLIC_SITE_URL=https://www.pixel-ring.com
SITE_URL=https://www.pixel-ring.com

# Required for migration/seed commands. Use a direct/non-pooling database URL.
DIRECT_URL=
POSTGRES_URL_NON_POOLING=

# Required admin portal keys. Use two different long random values.
ADMIN_MASTER_KEY_CRM=
ADMIN_MASTER_KEY_CMS=


# Optional private local attachment storage.
# For production, prefer a durable private object store and keep files non-public.
ATTACHMENT_STORAGE_DIR=
ATTACHMENT_MAX_UPLOAD_BYTES=10485760

# Optional. Defaults to 12 hours when omitted.
ADMIN_SESSION_TTL_HOURS=12

# Optional outbound notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Closed internal Telegram group/chat for manager alerts.
TELEGRAM_ADMIN_CHAT_ID=
# Legacy fallback for admin alerts. Prefer TELEGRAM_ADMIN_CHAT_ID for new setup.
TELEGRAM_CHAT_ID=

# Optional public messenger links. Safe to expose to the browser.
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# Optional Google Ads measurement. Enable only for production builds that should
# send Ads conversion events. The Ads ID and conversion label are public values.
NEXT_PUBLIC_GOOGLE_ADS_ENABLED=false
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18220277188
NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL=NDbWCL3P5LocEMS7jfBD

# Optional AI assistant configuration.
# Put the real key in .env.local for local development and in hosting env vars for production.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Default temperature. The CMS AI setting overrides this after it is saved.
AI_TEMPERATURE=0.2
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_MS=20000

# Optional CRM realtime updates.
# Server-only Ably API key. Do not expose this as NEXT_PUBLIC_*.
ABLY_API_KEY=

# Portal claim email delivery.
# Production requires a configured provider. IONOS SMTP example:
PORTAL_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=noreply@pixel-ring.com
SMTP_PASSWORD=
PORTAL_EMAIL_FROM="PixelRing Reparatur <noreply@pixel-ring.com>"

# Optional Resend fallback/provider.
RESEND_API_KEY=
