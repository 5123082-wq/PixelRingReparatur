generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CaseStatus {
  DRAFT
  FORMALIZED
  NUMBER_ISSUED
  UNDER_REVIEW
  WAITING_FOR_CUSTOMER
  IN_PROGRESS
  ON_HOLD
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum CaseOriginChannel {
  WEBSITE_CHAT
  WEBSITE_FORM
  TELEGRAM
  WHATSAPP
  PHONE
  EMAIL
  CRM
  MANUAL
}

enum PrimaryContactMethod {
  EMAIL
  PHONE
  TELEGRAM
  WHATSAPP
}

enum MessageAuthorRole {
  CUSTOMER
  OPERATOR
  SYSTEM
}

enum AdminRole {
  MANAGER
  OWNER
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum CmsArticleType {
  SYMPTOM
  FAQ
  PAGE
  SERVICE
  CASE
}

enum CmsArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CmsRevisionSourceAction {
  CREATE
  UPDATE
  PUBLISH
  UNPUBLISH
  RESTORE
}

enum CmsMediaUsageType {
  GENERAL
  HERO
  ARTICLE
  SERVICE
  CASE
  PAGE
  CARD
  SEO
  ICON
}

enum CmsMediaStorageProvider {
  LOCAL
  VERCEL_BLOB
  S3
  EXTERNAL
}

enum AttachmentKind {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum AttachmentStorageProvider {
  PENDING
  VERCEL_BLOB
  S3
  LOCAL
}

enum SessionScope {
  ANONYMOUS_DRAFT
  CASE_ACCESS
  PORTAL_AUTH
}

enum PortalUserStatus {
  ACTIVE
  DISABLED
}

enum PortalCaseAccessSource {
  CLAIM_LINK
  ADMIN
  IMPORT
}

enum PortalEmailCodePurpose {
  SIGNUP
  PASSWORD_RESET
  CLAIM_ACCESS
}

model Case {
  id                       String                    @id @default(uuid()) @db.Uuid
  publicRequestNumber      String?                   @unique
  status                   CaseStatus                @default(DRAFT)
  originChannel            CaseOriginChannel
  customerName             String?
  customerEmail            String?
  customerPhone            String?
  assignedOperator         String?
  customerProfileId        String?                   @db.Uuid
  primaryContactMethod     PrimaryContactMethod?
  primaryContactValue      String?
  serviceLocation          String?                   @db.Text
  serviceLatitude          Float?
  serviceLongitude         Float?
  serviceLocationSource    String?
  summary                  String?                   @db.Text
  description              String?                   @db.Text
  locale                   String?
  aiEnabled                Boolean                   @default(true)
  aiPausedAt               DateTime?
  aiPausedReason           String?
  crmLeadId                String?
  crmCaseId                String?
  numberIssuedAt           DateTime?
  formalizedAt             DateTime?
  statusUpdatedAt          DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  messages                 Message[]
  attachments              Attachment[]
  sessions                 Session[]
  portalClaimLinks         PortalClaimLink[]
  telegramIntakeLinks      TelegramIntakeLink[]
  portalEmailVerifications PortalEmailVerification[]
  portalEmailCodes         PortalEmailCode[]
  portalCaseAccesses       PortalCaseAccess[]
  externalConversations    ExternalConversation[]
  customerProfile          CustomerProfile?          @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  statusEvents             CaseStatusEvent[]
  auditLogs                AdminAuditLog[]
  readStates               CaseReadState[]

  @@index([status, updatedAt])
  @@index([originChannel, createdAt])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([customerProfileId, updatedAt])
  @@index([assignedOperator, status])
  @@index([primaryContactMethod, primaryContactValue])
  @@map("cases")
}

model CustomerProfile {
  id                     String                @id @default(uuid()) @db.Uuid
  displayName            String?
  email                  String?
  phone                  String?
  emailNormalized        String?               @unique
  phoneNormalized        String?               @unique
  preferredLanguage      String?
  preferredContactMethod PrimaryContactMethod?
  companyName            String?
  serviceAddress         String?               @db.Text
  serviceLatitude        Float?
  serviceLongitude       Float?
  serviceLocationSource  String?
  consentNotes           String?               @db.Text
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  cases                  Case[]

  @@index([displayName, updatedAt])
  @@index([updatedAt])
  @@map("customer_profiles")
}

model Message {
  id                String            @id @default(uuid()) @db.Uuid
  caseId            String?           @db.Uuid
  sessionId         String?           @db.Uuid
  channel           CaseOriginChannel
  authorRole        MessageAuthorRole
  authorName        String?
  body              String            @db.Text
  externalChatId    String?
  externalMessageId String?
  isCustomerVisible Boolean           @default(true)
  sentAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  case              Case?             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  session           Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  attachments       Attachment[]

  @@unique([channel, externalChatId, externalMessageId])
  @@index([caseId, createdAt])
  @@index([sessionId, createdAt])
  @@index([authorRole, createdAt])
  @@index([channel, externalChatId])
  @@map("messages")
}

model ExternalConversation {
  id             String            @id @default(uuid()) @db.Uuid
  caseId         String            @db.Uuid
  channel        CaseOriginChannel
  externalChatId String
  externalUserId String?
  username       String?
  firstName      String?
  lastName       String?
  lastMessageAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  case           Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  intakeLinks    TelegramIntakeLink[]

  @@unique([channel, externalChatId])
  @@index([caseId])
  @@index([channel, lastMessageAt])
  @@map("external_conversations")
}

model TelegramIntakeLink {
  id                     String               @id @default(uuid()) @db.Uuid
  tokenHash              String               @unique
  caseId                 String               @db.Uuid
  externalConversationId String               @db.Uuid
  telegramChatId         String
  telegramUserId         String?
  locale                 String?
  returnNonce            String               @unique
  openedAt               DateTime?
  submittedAt            DateTime?
  revokedAt              DateTime?
  expiresAt              DateTime
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  case                   Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  externalConversation   ExternalConversation @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)

  @@index([caseId, expiresAt])
  @@index([externalConversationId, expiresAt])
  @@index([expiresAt])
  @@index([telegramChatId, createdAt])
  @@index([submittedAt])
  @@map("telegram_intake_links")
}

model CaseReadState {
  id          String    @id @default(uuid()) @db.Uuid
  caseId      String    @db.Uuid
  adminUserId String    @db.Uuid
  lastReadAt  DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([caseId, adminUserId])
  @@index([adminUserId, updatedAt])
  @@index([caseId, lastReadAt])
  @@map("case_read_states")
}

model Attachment {
  id                  String                    @id @default(uuid()) @db.Uuid
  caseId              String?                   @db.Uuid
  messageId           String?                   @db.Uuid
  uploadedBySessionId String?                   @db.Uuid
  kind                AttachmentKind
  storageProvider     AttachmentStorageProvider @default(PENDING)
  storageKey          String                    @unique
  originalFilename    String?
  mimeType            String
  byteSize            Int
  checksumSha256      String?
  width               Int?
  height              Int?
  durationSeconds     Int?
  isCustomerVisible   Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  case                Case?                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  message             Message?                  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBySession   Session?                  @relation("SessionUploads", fields: [uploadedBySessionId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([messageId])
  @@index([uploadedBySessionId])
  @@map("attachments")
}

model Session {
  id               String                @id @default(uuid()) @db.Uuid
  tokenHash        String                @unique
  scope            SessionScope          @default(ANONYMOUS_DRAFT)
  caseId           String?               @db.Uuid
  portalUserId     String?               @db.Uuid
  operatorTakeover Boolean               @default(false)
  contactMethod    PrimaryContactMethod?
  contactValue     String?
  userAgent        String?
  ipAddress        String?
  verifiedAt       DateTime?
  lastSeenAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  case             Case?                 @relation(fields: [caseId], references: [id], onDelete: SetNull)
  portalUser       PortalUser?           @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  messages         Message[]
  uploads          Attachment[]          @relation("SessionUploads")
  intakeDraft      SessionIntakeDraft?

  @@index([caseId, expiresAt])
  @@index([portalUserId, expiresAt])
  @@index([expiresAt])
  @@index([contactMethod, contactValue])
  @@map("sessions")
}

model SessionIntakeDraft {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @unique @db.Uuid
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  serviceLocation String?  @db.Text
  serviceLatitude Float?
  serviceLongitude Float?
  serviceLocationSource String?
  issueType       String?
  summary         String?  @db.Text
  locale          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("session_intake_drafts")
}

model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  displayName  String?
  passwordHash String
  role         AdminRole       @default(MANAGER)
  status       AdminUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[] @relation("AdminAuditLogActorUser")
  readStates   CaseReadState[]

  @@index([role, status])
  @@index([status, updatedAt])
  @@map("admin_users")
}

model AdminSession {
  id               String            @id @default(uuid()) @db.Uuid
  adminUserId      String            @db.Uuid
  tokenHash        String            @unique
  role             AdminRole         @default(MANAGER)
  label            String?
  ipAddress        String?
  userAgent        String?
  lastSeenAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  adminUser        AdminUser         @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  statusEvents     CaseStatusEvent[] @relation("CaseStatusEventActor")
  auditLogs        AdminAuditLog[]   @relation("AdminAuditLogActor")
  portalClaimLinks PortalClaimLink[] @relation("PortalClaimLinkCreatedBy")

  @@index([expiresAt])
  @@index([role])
  @@index([adminUserId, expiresAt])
  @@index([revokedAt])
  @@map("admin_sessions")
}

model PortalClaimLink {
  id                      String                    @id @default(uuid()) @db.Uuid
  tokenHash               String                    @unique
  caseId                  String                    @db.Uuid
  locale                  String?
  prefillEmail            String?
  requestedEmail          String?
  createdByAdminSessionId String?                   @db.Uuid
  lastOpenedAt            DateTime?
  expiresAt               DateTime
  consumedAt              DateTime?
  revokedAt               DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  case                    Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdByAdminSession   AdminSession?             @relation("PortalClaimLinkCreatedBy", fields: [createdByAdminSessionId], references: [id], onDelete: SetNull)
  emailVerifications      PortalEmailVerification[]
  emailCodes              PortalEmailCode[]

  @@index([caseId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("portal_claim_links")
}

model PortalEmailVerification {
  id              String          @id @default(uuid()) @db.Uuid
  tokenHash       String          @unique
  claimLinkId     String          @db.Uuid
  caseId          String          @db.Uuid
  email           String
  emailNormalized String
  expiresAt       DateTime
  verifiedAt      DateTime?
  consumedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  claimLink       PortalClaimLink @relation(fields: [claimLinkId], references: [id], onDelete: Cascade)
  case            Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, emailNormalized])
  @@index([claimLinkId, expiresAt])
  @@index([expiresAt])
  @@map("portal_email_verifications")
}

model PortalUser {
  id                     String             @id @default(uuid()) @db.Uuid
  displayName            String?
  primaryEmail           String
  primaryEmailNormalized String             @unique
  passwordHash           String?
  passwordSetAt          DateTime?
  status                 PortalUserStatus   @default(ACTIVE)
  lastLoginAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  emails                 PortalUserEmail[]
  caseAccesses           PortalCaseAccess[]
  sessions               Session[]

  @@index([status, updatedAt])
  @@map("portal_users")
}

model PortalEmailCode {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String
  emailNormalized       String
  codeHash              String
  verificationTokenHash String?                @unique
  purpose               PortalEmailCodePurpose
  claimLinkId           String?                @db.Uuid
  caseId                String?                @db.Uuid
  expiresAt             DateTime
  verifiedAt            DateTime?
  consumedAt            DateTime?
  attempts              Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  claimLink             PortalClaimLink?       @relation(fields: [claimLinkId], references: [id], onDelete: Cascade)
  case                  Case?                  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([emailNormalized, purpose, expiresAt])
  @@index([claimLinkId, purpose, expiresAt])
  @@index([caseId, purpose, expiresAt])
  @@index([expiresAt])
  @@map("portal_email_codes")
}

model PortalUserEmail {
  id              String     @id @default(uuid()) @db.Uuid
  portalUserId    String     @db.Uuid
  email           String
  emailNormalized String     @unique
  verifiedAt      DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  portalUser      PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId, verifiedAt])
  @@map("portal_user_emails")
}

model PortalCaseAccess {
  id           String                 @id @default(uuid()) @db.Uuid
  portalUserId String                 @db.Uuid
  caseId       String                 @db.Uuid
  source       PortalCaseAccessSource @default(CLAIM_LINK)
  grantedAt    DateTime               @default(now())
  revokedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  portalUser   PortalUser             @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  case         Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([portalUserId, caseId])
  @@index([caseId, revokedAt])
  @@index([portalUserId, revokedAt])
  @@map("portal_case_accesses")
}

model CaseStatusEvent {
  id             String        @id @default(uuid()) @db.Uuid
  caseId         String        @db.Uuid
  actorSessionId String?       @db.Uuid
  actorRole      AdminRole?
  fromStatus     CaseStatus?
  toStatus       CaseStatus
  reason         String?       @db.Text
  metadata       Json?
  createdAt      DateTime      @default(now())
  case           Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorSession   AdminSession? @relation("CaseStatusEventActor", fields: [actorSessionId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([actorSessionId, createdAt])
  @@index([toStatus, createdAt])
  @@map("case_status_events")
}

model AdminAuditLog {
  id               String        @id @default(uuid()) @db.Uuid
  actorSessionId   String?       @db.Uuid
  actorAdminUserId String?       @db.Uuid
  actorRole        AdminRole?
  action           String
  resourceType     String
  resourceId       String?
  caseId           String?       @db.Uuid
  outcome          String        @default("SUCCESS")
  reason           String?       @db.Text
  details          Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime      @default(now())
  actorSession     AdminSession? @relation("AdminAuditLogActor", fields: [actorSessionId], references: [id], onDelete: SetNull)
  actorAdminUser   AdminUser?    @relation("AdminAuditLogActorUser", fields: [actorAdminUserId], references: [id], onDelete: SetNull)
  case             Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
  @@index([caseId, createdAt])
  @@index([actorSessionId, createdAt])
  @@index([actorAdminUserId, createdAt])
  @@map("admin_audit_logs")
}

model CmsArticle {
  id               String               @id @default(uuid()) @db.Uuid
  locale           String               @default("de")
  type             CmsArticleType       @default(SYMPTOM)
  status           CmsArticleStatus     @default(DRAFT)
  slug             String
  title            String
  symptomLabel     String?
  shortAnswer      String?              @db.Text
  content          String               @db.Text
  seoTitle         String?
  seoDescription   String?              @db.Text
  canonicalUrl     String?
  relatedSlugs     String[]             @default([])
  causes           String[]             @default([])
  safeChecks       String[]             @default([])
  selfRepairTips   Json?
  urgentWarnings   String[]             @default([])
  serviceProcess   String[]             @default([])
  workScopeFactors String[]             @default([])
  ctaLabel         String?
  ctaHref          String?
  sortOrder        Int                  @default(0)
  publishedAt      DateTime?
  lastReviewedAt   DateTime?
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  revisions        CmsArticleRevision[]

  @@unique([locale, slug])
  @@index([locale, type, status, sortOrder])
  @@index([locale, type, status, publishedAt])
  @@index([status, updatedAt])
  @@index([deletedAt])
  @@map("cms_articles")
}

model CmsPage {
  id             String            @id @default(uuid()) @db.Uuid
  pageKey        String
  locale         String            @default("de")
  status         CmsArticleStatus  @default(DRAFT)
  title          String
  blocks         Json
  seoTitle       String?
  seoDescription String?           @db.Text
  canonicalUrl   String?
  publishedAt    DateTime?
  lastReviewedAt DateTime?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  revisions      CmsPageRevision[]

  @@unique([pageKey, locale])
  @@index([locale, status])
  @@index([deletedAt])
  @@map("cms_pages")
}

model CmsArticleRevision {
  id               String                  @id @default(uuid()) @db.Uuid
  articleId        String                  @db.Uuid
  sourceAction     CmsRevisionSourceAction @default(UPDATE)
  reason           String?                 @db.Text
  actorAdminUserId String?                 @db.Uuid
  actorSessionId   String?                 @db.Uuid
  actorRole        AdminRole?
  snapshot         Json
  createdAt        DateTime                @default(now())
  article          CmsArticle              @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([createdAt])
  @@index([actorAdminUserId, createdAt])
  @@index([actorSessionId, createdAt])
  @@map("cms_article_revisions")
}

model CmsPageRevision {
  id               String                  @id @default(uuid()) @db.Uuid
  pageId           String                  @db.Uuid
  sourceAction     CmsRevisionSourceAction @default(UPDATE)
  reason           String?                 @db.Text
  actorAdminUserId String?                 @db.Uuid
  actorSessionId   String?                 @db.Uuid
  actorRole        AdminRole?
  snapshot         Json
  createdAt        DateTime                @default(now())
  page             CmsPage                 @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@index([createdAt])
  @@index([actorAdminUserId, createdAt])
  @@index([actorSessionId, createdAt])
  @@map("cms_page_revisions")
}

model CmsMedia {
  id                 String                  @id @default(uuid()) @db.Uuid
  locale             String                  @default("de")
  usageType          CmsMediaUsageType       @default(GENERAL)
  storageProvider    CmsMediaStorageProvider @default(LOCAL)
  storageKey         String                  @unique
  publicUrl          String                  @unique
  fallbackUrl        String?
  fallbackStorageKey String?
  originalFilename   String?
  title              String?
  altText            String?
  mimeType           String
  byteSize           Int
  checksumSha256     String
  width              Int?
  height             Int?
  meta               Json?
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([locale, usageType, updatedAt])
  @@index([mimeType, updatedAt])
  @@index([checksumSha256])
  @@index([deletedAt])
  @@map("cms_media")
}

model AiConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("ai_configs")
}

model CmsSeoConfig {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_seo_configs")
}
